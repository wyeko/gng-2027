---
import Section from './ui/Section.astro';
import SectionHead from './ui/SectionHead.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).partners;
---

<Section id="partners" bg="mesh2">
  <SectionHead id="partners" kicker={d.kicker}>{d.h2}</SectionHead>
  {/* TODO: logos — swap the text chips for a monochrome logo wall once logo files exist */}
  <ul class="partners" role="list" data-reveal="up">
    {d.list.map((p) => <li class="partner">{p}</li>)}
  </ul>
  <div class="support" data-reveal="up">
    <p class="k c-teal">{d.supportLabel}</p>
    <ul class="support__list" role="list">
      {d.support.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</Section>

<style>
  .partners {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }
  .partner {
    display: grid;
    place-items: center;
    min-height: 76px;
    padding: 12px 16px;
    border-radius: var(--r-card);
    background: var(--card);
    font-family: var(--font-wide);
    font-stretch: 125%;
    font-weight: 800;
    font-size: var(--fs-16);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-align: center;
    line-height: 1.15;
  }
  .support {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
  }
  .support__list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
  }
  .support__list li:not(:last-child)::after {
    content: '·';
    margin: 0 10px;
    color: var(--teal-text);
  }
  @media (max-width: 479px) {
    .partners {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .partner {
      min-height: 64px;
      font-size: var(--fs-13);
    }
  }
</style>
