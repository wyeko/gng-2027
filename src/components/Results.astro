---
import Section from './ui/Section.astro';
import MeterList from './ui/MeterList.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).results;
---

<Section id="results" bg="swirl">
  <div class="results grain on-dark" data-reveal="up">
    <header class="results__head">
      <div class="stack results__titles">
        <p class="k results__kicker">{d.kicker}</p>
        <h2 id="results-title" class="d h2">{d.h2}</h2>
        <p class="results__meta">{d.meta}</p>
      </div>
      <p class="results__ref">{d.reference}</p>
    </header>

    <ul class="results__stats" role="list" data-reveal="stagger">
      {
        d.stats.map((s) => (
          <li>
            <p class="d t-32 c-mint rise-num">
              <span>{s.value}</span>
            </p>
            <p>{s.label}</p>
          </li>
        ))
      }
    </ul>

    <div class="results__charts" data-reveal="up">
      <div class="results__chart">
        <h3 class="k results__kicker">{d.viewsTitle}</h3>
        <MeterList rows={d.views} label={d.viewsTitle} dark lang={lang} />
      </div>
      <div class="results__chart">
        <h3 class="k results__kicker">{d.interactionsTitle}</h3>
        <MeterList rows={d.interactions} label={d.interactionsTitle} dark lang={lang} />
      </div>
    </div>

    <footer class="results__foot">
      <p class="results__insight">{d.insight}</p>
      <p class="results__goal"><span class="k">{d.goalLabel}</span> {d.goal}</p>
    </footer>
  </div>
</Section>

<style>
  .results {
    background: var(--teal-deep);
    color: var(--white);
    border-radius: var(--r-big);
    padding: clamp(24px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .results__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 40px;
  }
  .results__titles {
    gap: 14px;
    max-width: 760px;
  }
  .results__kicker {
    color: var(--baby-blue);
  }
  .results__meta {
    color: var(--ice-text);
    font-size: var(--fs-16);
  }
  .results__ref {
    padding: 10px 16px;
    border-radius: var(--r-pill);
    border: 1.5px solid rgb(255 255 255 / 0.35);
    font-weight: 600;
  }
  .results__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
  }
  .results__stats > li {
    padding: 18px 20px 20px;
    border-top: 1.5px solid rgb(255 255 255 / 0.18);
    border-left: 1.5px solid rgb(255 255 255 / 0.18);
  }
  .results__stats > li:nth-child(4n + 1) {
    border-left: 0;
    padding-left: 0;
  }
  .results__stats > li p:last-child {
    margin-top: 6px;
    color: var(--ice-text);
  }
  .results__charts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
  }
  .results__chart {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .results__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    padding-top: 24px;
    border-top: 1.5px solid rgb(255 255 255 / 0.18);
  }
  .results__insight {
    font-size: var(--fs-18);
    max-width: 34em;
  }
  .results__goal {
    padding: 12px 18px;
    border-radius: var(--r-pill);
    background: var(--mint);
    color: var(--ink);
    font-weight: 600;
  }
  .results__goal .k {
    margin-right: 6px;
  }
  @media (max-width: 900px) {
    .results__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .results__stats > li:nth-child(4n + 1) {
      border-left: 1.5px solid rgb(255 255 255 / 0.18);
      padding-left: 20px;
    }
    .results__stats > li:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    .results__charts {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 479px) {
    .results {
      padding: 24px 18px;
      border-radius: var(--r-card);
    }
    .results__stats > li {
      padding: 14px 12px 16px;
    }
    .results__stats > li:nth-child(odd) {
      padding-left: 0;
    }
  }
</style>
