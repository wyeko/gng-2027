---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** responsive `sizes` attribute, e.g. "(min-width: 1024px) 33vw, 100vw" */
  sizes: string;
  /** CSS aspect-ratio for the frame, e.g. "4 / 3" */
  ratio?: string;
  /** object-position for the crop, e.g. "50% 30%" */
  pos?: string;
  cloud?: boolean;
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes, ratio, pos, cloud = false, eager = false, class: cls } = Astro.props;

// WebP, max 1600px, quality ~80 (brief). Never upscale past the source.
const max = Math.min(src.width, 1600);
const widths = [400, 640, 960, 1280, 1600].filter((w) => w < max);
widths.push(max);
const style = [ratio && `aspect-ratio:${ratio}`].filter(Boolean).join(';');
---

<div class:list={['media', { cloud }, cls]} style={style || undefined}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={80}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
    style={pos ? `object-position:${pos}` : undefined}
  />
  <slot />
</div>
