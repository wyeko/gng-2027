---
/**
 * Name · bar · figure per row. One hue; optional emphasis rows in the
 * accent, the rest in a quiet de-emphasis tone. Values are printed, so the
 * list doubles as the table view (no colour-only encoding).
 */
interface Row {
  label: string;
  value: number;
  display?: string;
}
interface Props {
  rows: Row[];
  label: string;
  unit?: string;
  highlight?: string[];
  dark?: boolean;
  lang: 'en' | 'hr';
}
const { rows, label, unit = '', highlight, dark = false, lang } = Astro.props;
const max = Math.max(...rows.map((r) => r.value));
const fmt = (v: number) => v.toLocaleString(lang === 'hr' ? 'hr-HR' : 'en-GB', { maximumFractionDigits: 1 });
---

<ul class:list={['meters', { 'meters--dark': dark }]} aria-label={label}>
  {
    rows.map((r, i) => {
      const on = !highlight || highlight.includes(r.label);
      return (
        <li class:list={['meter', { 'is-quiet': !on }]} style={`--bar-d:${i * 50}ms`}>
          <span class="meter__label">{r.label}</span>
          <span class="meter__track" aria-hidden="true">
            <span class="bar__fill" style={`width:${Math.max((r.value / max) * 100, 1.5)}%`} />
          </span>
          <span class="meter__val">{r.display ?? `${fmt(r.value)}${unit}`}</span>
        </li>
      );
    })
  }
</ul>

<style>
  .meters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    --fill: var(--teal-text);
    --quiet: rgb(14 47 79 / 0.24);
    --track: rgb(5 94 117 / 0.1);
    --label: var(--ink);
  }
  .meters--dark {
    --fill: var(--mint);
    --quiet: rgb(255 255 255 / 0.32);
    --track: rgb(255 255 255 / 0.1);
    --label: var(--white);
  }
  .meter {
    display: grid;
    grid-template-columns: minmax(5.5em, max-content) 1fr 4.2em;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-16);
    color: var(--label);
  }
  .meter__label {
    min-width: 0;
  }
  .meter__track {
    position: relative;
    height: 10px;
    background: var(--track);
    border-radius: 0 4px 4px 0;
  }
  .meter :global(.bar__fill) {
    display: block;
    height: 100%;
    background: var(--fill);
    border-radius: 0 4px 4px 0;
  }
  .meter.is-quiet :global(.bar__fill) {
    background: var(--quiet);
  }
  .meter__val {
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .meter.is-quiet .meter__val {
    font-weight: 400;
  }
</style>
